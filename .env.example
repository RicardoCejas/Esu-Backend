# =============================================================================
# ESU (Ecosistema de Salud Unificado) - Plantilla de Variables de Entorno
# =============================================================================
# NOTA: Configurar estas variables en el panel de Render (Environment Variables).
# NUNCA subir claves reales ni secretos a repositorios git.
# En producción, todos los placeholders CAMBIAR_* son rechazados en el arranque.

# Perfil Activo de Spring Boot ('prod')
SPRING_PROFILES_ACTIVE=prod
PORT=8080
SERVER_PORT=8080

# =============================================================================
# Base de Datos MySQL 8.4 (Instancia gestionada o externa para Render)
# =============================================================================
# Reemplace <HOST>, <PUERTO> y <BASE> con los datos entregados por su proveedor MySQL 8.4.
# NOTA TLS / Auth: useSSL=true y allowPublicKeyRetrieval=true son obligatorios para caching_sha2_password en MySQL 8.4.
SPRING_DATASOURCE_URL=jdbc:mysql://<HOST>:<PUERTO>/<BASE>?useSSL=true&requireSSL=true&allowPublicKeyRetrieval=true&serverTimezone=America/Argentina/Cordoba
SPRING_DATASOURCE_USERNAME=<USUARIO_MYSQL>
SPRING_DATASOURCE_PASSWORD=<PASSWORD_MYSQL>

# =============================================================================
# Seguridad JWT (Clave HMAC-SHA de al menos 256 bits / 32 bytes)
# =============================================================================
APP_JWT_SECRET=CAMBIAR_EN_PRODUCCION_CLAVE_JWT_MINIMO_32_CARACTERES_HEX_O_BASE64
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_ISSUER=esu-backend
APP_JWT_AUDIENCE=esu-frontend

# =============================================================================
# CORS y Cookies para despliegue Frontend en Vercel + Backend en Render
# =============================================================================
# Colocar URL HTTPS exacta de Vercel asignada a su frontend (ej: https://esu-frontend.vercel.app)
CORS_ALLOWED_ORIGINS=https://<TU_PROYECTO_FRONTEND>.vercel.app
FRONTEND_URL=https://<TU_PROYECTO_FRONTEND>.vercel.app
APP_AUTH_COOKIE_SAME_SITE=None
APP_AUTH_COOKIE_SECURE=true

# Proxies Confiables para resolución de IP (X-Forwarded-For) detrás de Render
TRUSTED_PROXIES=127.0.0.1,::1

# =============================================================================
# Mecanismo de Cuentas y Datos Semilla para Demostración Académica
# =============================================================================
# true en el primer arranque para cargar automáticamente usuarios, médicos y centros de prueba
APP_DEMO_SEED_ACCOUNTS=true

# =============================================================================
# Notificaciones por Correo (Configuración para Brevo / Sendinblue o SMTP institucional)
# =============================================================================
# Para activar envíos reales de correos, cambiar APP_MAIL_ENABLED a true
APP_MAIL_ENABLED=false
# Para Brevo utilizar: smtp-relay.brevo.com con puerto 587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
# Login SMTP de Brevo (obtenido en panel Brevo -> SMTP & API -> SMTP)
SMTP_USERNAME=tu_usuario_smtp_de_brevo
# Clave SMTP Maestra generada en Brevo (Master Password)
SMTP_PASSWORD=tu_master_password_smtp_de_brevo
# IMPORTANTE: MAIL_FROM debe ser un remitente verificado en Brevo (Senders & IPs)
MAIL_FROM=notificaciones@tudominio.com

# =============================================================================
# Google OAuth2 (Desactivado para la demo)
# =============================================================================
APP_AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=

# =============================================================================
# Almacenamiento Persistente de Estudios Adjuntos
# =============================================================================
# En Render: Adjuntar un Persistent Disk con Mount Path '/app/uploads/estudios'
ESU_UPLOADS_ESTUDIOS_DIR=/app/uploads/estudios

# Zona Horaria Institucional
TZ=America/Argentina/Cordoba
