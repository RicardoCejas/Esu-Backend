# =============================================================================
# ESU (Ecosistema de Salud Unificado) - Plantilla de Variables de Entorno
# =============================================================================
# NOTA: Duplicar este archivo como '.env' en la raíz y/o directorio Backend.
# NUNCA subir claves reales ni secretos a repositorios git.
# En producción, todos los placeholders CAMBIAR_* son rechazados en el arranque.

# Perfil Activo de Spring Boot ('prod', 'dev', 'local')
SPRING_PROFILES_ACTIVE=prod
PORT=8080
SERVER_PORT=8080

# Base de Datos MySQL (Usuario con privilegios mínimos, NO usar root en producción)
MYSQL_DATABASE=db_esu
MYSQL_USER=esu_app
MYSQL_PASSWORD=CAMBIAR_EN_PRODUCCION_PASSWORD_MYSQL_ESU_APP
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_esu?createDatabaseIfNotExist=true&serverTimezone=America/Argentina/Cordoba

# Seguridad JWT (Clave HMAC-SHA de al menos 256 bits / 32 bytes)
APP_JWT_SECRET=CAMBIAR_EN_PRODUCCION_CLAVE_JWT_MINIMO_32_CARACTERES_HEX_O_BASE64
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_ISSUER=esu-backend
APP_JWT_AUDIENCE=esu-frontend

# Secreto para Switch de Rol exclusivo en perfil 'dev' o 'local' (En 'prod' se deshabilita automáticamente)
ESU_DEV_SECRET=CAMBIAR_OPCIONAL_SECRETO_LOCAL_DEV

# CORS y Cookies para despliegue Frontend en Vercel + Backend en Render
# Colocar URL HTTPS exacta de Vercel (ej: https://esu-frontend.vercel.app)
CORS_ALLOWED_ORIGINS=https://esu-frontend.vercel.app,https://cruzdeleje.gob.ar
APP_AUTH_COOKIE_SAME_SITE=None
APP_AUTH_COOKIE_SECURE=true

# Proxies Confiables para resolución de IP (X-Forwarded-For) detrás de Render/Cloudflare
TRUSTED_PROXIES=127.0.0.1,::1

# Configuración SMTP para Notificaciones por Correo Electrónico
SMTP_HOST=CAMBIAR_SMTP_HOST_PRODUCCION
SMTP_PORT=587
SMTP_USERNAME=notificaciones@cruzdeleje.gob.ar
SMTP_PASSWORD=CAMBIAR_EN_PRODUCCION_PASSWORD_SMTP_REAL
MAIL_FROM=notificaciones@cruzdeleje.gob.ar

# URLs de Aplicación y API Frontend
FRONTEND_URL=https://esu-frontend.vercel.app
VITE_API_URL=/api

# Almacenamiento Persistente de Estudios Adjuntos
# NOTA RENDER: Adjuntar un Render Persistent Disk con Mount Path '/app/uploads/estudios'
ESU_UPLOADS_ESTUDIOS_DIR=/app/uploads/estudios

# Zona Horaria Institucional
TZ=America/Argentina/Cordoba

# Google OAuth 2.0 / OpenID Connect (Desactivado explícitamente por defecto hasta configurar)
APP_AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
